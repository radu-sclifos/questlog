# Normalize text files and store them with LF
* text=auto

# Source code and configuration
*.java       text eol=lf
*.xml        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.properties text eol=lf
*.sql        text eol=lf

*.ts         text eol=lf
*.html       text eol=lf
*.scss       text eol=lf
*.css        text eol=lf
*.json       text eol=lf
*.md         text eol=lf

# Unix shell scripts
*.sh         text eol=lf
mvnw         text eol=lf

# Windows scripts
*.cmd        text eol=crlf
*.bat        text eol=crlf
*.ps1        text eol=crlf

# Binary files
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.webp       binary
*.woff       binary
*.woff2      binary